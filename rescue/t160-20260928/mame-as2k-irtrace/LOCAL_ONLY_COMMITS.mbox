From 9bef3ad7c9777df03df026ad33164ec7de4478a3 Mon Sep 17 00:00:00 2001
From: SamDelorean <184150317+SamDelorean@users.noreply.github.com>
Date: Thu, 17 Sep 2026 20:30:41 -0600
Subject: [PATCH] asma2k: repair PC Send build dependencies

---
 src/devices/cpu/mc68hc11/mc68hc11.cpp |  2 ++
 src/devices/cpu/mc68hc11/mc68hc11.h   |  2 ++
 src/mame/skeleton/alphasma.cpp        | 10 +++++-----
 3 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/src/devices/cpu/mc68hc11/mc68hc11.cpp b/src/devices/cpu/mc68hc11/mc68hc11.cpp
index 375c6e1c2a2..f04a2d8eb61 100644
--- a/src/devices/cpu/mc68hc11/mc68hc11.cpp
+++ b/src/devices/cpu/mc68hc11/mc68hc11.cpp
@@ -70,6 +70,7 @@ mc68hc11_cpu_device::mc68hc11_cpu_device(const machine_config &mconfig, device_t
 	, m_analog_cb(*this, 0)
 	, m_spi2_data_input_cb(*this, 0xff)
 	, m_spi2_data_output_cb(*this)
+	, m_instruction_cb(*this)
 	, m_ram_view(*this, "ram")
 	, m_reg_view(*this, "regs")
 	, m_eeprom_view(*this, "eeprom")
@@ -1239,6 +1240,7 @@ void mc68hc11_cpu_device::execute_run()
 		else
 		{
 			m_ppc = m_pc;
+			m_instruction_cb(m_pc);
 			debugger_instruction_hook(m_pc);
 
 			op = FETCH();
diff --git a/src/devices/cpu/mc68hc11/mc68hc11.h b/src/devices/cpu/mc68hc11/mc68hc11.h
index a7248de563b..bc06cc26760 100644
--- a/src/devices/cpu/mc68hc11/mc68hc11.h
+++ b/src/devices/cpu/mc68hc11/mc68hc11.h
@@ -49,6 +49,7 @@ public:
 	auto in_an7_callback() { return m_analog_cb[7].bind(); }
 	auto in_spi2_data_callback() { return m_spi2_data_input_cb.bind(); }
 	auto out_spi2_data_callback() { return m_spi2_data_output_cb.bind(); }
+	auto instruction_callback() { return m_instruction_cb.bind(); }
 
 	void set_default_config(uint8_t data) { assert(!configured()); m_config = data & m_config_mask; }
 
@@ -175,6 +176,7 @@ private:
 	devcb_read8::array<8> m_analog_cb;
 	devcb_read8 m_spi2_data_input_cb;
 	devcb_write8 m_spi2_data_output_cb;
+	devcb_write16 m_instruction_cb;
 	int m_icount;
 
 	memory_view m_ram_view;
diff --git a/src/mame/skeleton/alphasma.cpp b/src/mame/skeleton/alphasma.cpp
index 3a89e36c0bf..ccb65e49d4a 100644
--- a/src/mame/skeleton/alphasma.cpp
+++ b/src/mame/skeleton/alphasma.cpp
@@ -541,11 +541,6 @@ static INPUT_PORTS_START( alphasmart )
 	PORT_BIT(0x40, IP_ACTIVE_LOW, IPT_UNUSED)
 	PORT_BIT(0x80, IP_ACTIVE_LOW, IPT_KEYBOARD) PORT_CODE(KEYCODE_RSHIFT) PORT_CHAR(UCHAR_MAMEKEY(RSHIFT)) PORT_CHANGED_MEMBER(DEVICE_SELF, FUNC(alphasmart_state::kb_irq), 0)
 
-	PORT_START("PC_CONNECTED")
-	PORT_CONFNAME(0x01, 0x00, "PC Connected")
-	PORT_CONFSETTING(0x00, DEF_STR(Off))
-	PORT_CONFSETTING(0x01, DEF_STR(On))
-
 	PORT_START("BATTERY")
 	PORT_CONFNAME(0x01, 0x01, "Battery status")
 	PORT_CONFSETTING (0x00, DEF_STR(Low))
@@ -698,6 +693,11 @@ static INPUT_PORTS_START( asma2k )
 	PORT_BIT(0x40, IP_ACTIVE_LOW, IPT_KEYBOARD) PORT_CODE(KEYCODE_M)    PORT_CHAR('m')  PORT_CHAR('M')  PORT_CHANGED_MEMBER(DEVICE_SELF, FUNC(alphasmart_state::kb_irq), 0)
 	PORT_BIT(0x80, IP_ACTIVE_LOW, IPT_KEYBOARD) PORT_CODE(KEYCODE_N)    PORT_CHAR('n')  PORT_CHAR('N')  PORT_CHANGED_MEMBER(DEVICE_SELF, FUNC(alphasmart_state::kb_irq), 0)
 
+	PORT_START("PC_CONNECTED")
+	PORT_CONFNAME(0x01, 0x00, "PC Connected")
+	PORT_CONFSETTING(0x00, DEF_STR(Off))
+	PORT_CONFSETTING(0x01, DEF_STR(On))
+
 	PORT_START("BATTERY")
 	PORT_CONFNAME(0x01, 0x01, "Battery status")
 	PORT_CONFSETTING (0x00, DEF_STR(Low))
-- 
2.53.0

From 044d4cbb52f6960d5c4af614e738aa26f97162a4 Mon Sep 17 00:00:00 2001
From: SamDelorean <184150317+SamDelorean@users.noreply.github.com>
Date: Thu, 17 Sep 2026 20:45:09 -0600
Subject: [PATCH] asma2k: bind PC attachment toggle to Pause/Break

---
 src/mame/skeleton/alphasma.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/mame/skeleton/alphasma.cpp b/src/mame/skeleton/alphasma.cpp
index ccb65e49d4a..b8b5db15886 100644
--- a/src/mame/skeleton/alphasma.cpp
+++ b/src/mame/skeleton/alphasma.cpp
@@ -693,10 +693,10 @@ static INPUT_PORTS_START( asma2k )
 	PORT_BIT(0x40, IP_ACTIVE_LOW, IPT_KEYBOARD) PORT_CODE(KEYCODE_M)    PORT_CHAR('m')  PORT_CHAR('M')  PORT_CHANGED_MEMBER(DEVICE_SELF, FUNC(alphasmart_state::kb_irq), 0)
 	PORT_BIT(0x80, IP_ACTIVE_LOW, IPT_KEYBOARD) PORT_CODE(KEYCODE_N)    PORT_CHAR('n')  PORT_CHAR('N')  PORT_CHANGED_MEMBER(DEVICE_SELF, FUNC(alphasmart_state::kb_irq), 0)
 
+	// Emulator-only host attachment control.  Pause/Break is not part of the
+	// AlphaSmart 2000 keyboard matrix, so it cannot be mistaken for an AS2K key.
 	PORT_START("PC_CONNECTED")
-	PORT_CONFNAME(0x01, 0x00, "PC Connected")
-	PORT_CONFSETTING(0x00, DEF_STR(Off))
-	PORT_CONFSETTING(0x01, DEF_STR(On))
+	PORT_BIT(0x01, IP_ACTIVE_HIGH, IPT_OTHER) PORT_NAME("PC Connected (Pause/Break)") PORT_CODE(KEYCODE_PAUSE) PORT_TOGGLE
 
 	PORT_START("BATTERY")
 	PORT_CONFNAME(0x01, 0x01, "Battery status")
-- 
2.53.0

