+// Only DIAG mode observes HC11 PD1 physical timings. Stock $8E62 uses
+// high-duration encoding: short=1, long=0, preceded by one start bit.
+// The register 0 payload comprises 16 bits, MSB first, in two bytes.
+// This is strictly a passive capture: no firmware RAM/PC injection.
+void asma2k_state::mac_adb_edge(bool old_level, bool new_level)
+{
+    if (!std::getenv("AS2K_DIAG_ADB_SINK") || !std::getenv("AS2K_DIAG_ADB_SINK")[0])
+        return;
+    uint64_t const ticks = machine().time().as_ticks(2'000'000);
+    if (new_level)
+    {
+        m_mac_rise_tick = ticks;
+        m_mac_rise_valid = true;
+        return;
+    }
+    if (old_level && m_mac_rise_valid)
+    {
+        m_mac_rise_valid = false;
+        uint64_t const high_ticks = ticks - m_mac_rise_tick;
+        // Original $8E62: 10-count high for 1; 22-count high for 0.
+        // 2 MHz E-clock, 5 cycles/AAEC iteration; conservative guard.
+        if (high_ticks < 25 || high_ticks > 300)
+        {
+            m_mac_bits = 0;
+            m_mac_started = false;
+            logerror("AS2K_ADB_PHY BAD_PULSE ticks=%llu\n", static_cast<unsigned long long>(high_ticks));
+            return;
+        }
+        bool const bit = high_ticks < 84;
+        if (!m_mac_started)
+        {
+            if (!bit)
+                return; // Not an ADB start mark.
+            m_mac_started = true;
+            m_mac_bits = 0;
+            m_mac_frame = 0;
+            return;
+        }
+        m_mac_frame = (m_mac_frame << 1) | unsigned(bit);
+        if (++m_mac_bits == 16)
+        {
+            mac_adb_packet(m_mac_frame);
+            m_mac_started = false;
+            m_mac_bits = 0;
+        }
+    }
+}
+
+void asma2k_state::mac_sink_open()
+{
+    if (m_mac_sink)
+        return;
+    std::string rom_directory;
+    path_iterator paths(machine().options().media_path());
+    if (!paths.next(rom_directory) || rom_directory.empty())
+        return;
+    m_mac_sink = std::make_unique<emu_file>(rom_directory,
+        OPEN_FLAG_WRITE | OPEN_FLAG_CREATE | OPEN_FLAG_CREATE_PATHS);
+    if (std::error_condition const err = m_mac_sink->open("as2kdiag-adb.txt"); err)
+    {
+        logerror("AS2K_ADB_TEXT OPEN_FAIL %s\n", err.message());
+        m_mac_sink.reset();
+    }
+    else
+        logerror("AS2K_ADB_TEXT OPEN path=%s\n", m_mac_sink->fullpath());
+}
+
+void asma2k_state::mac_sink_close()
+{
+    if (m_mac_sink)
+    {
+        m_mac_sink->flush();
+        logerror("AS2K_ADB_TEXT CLOSE packets=%llu path=%s\n",
+            static_cast<unsigned long long>(m_mac_packets),m_mac_sink->fullpath());
+        m_mac_sink->close();
+        m_mac_sink.reset();
+    }
+    m_mac_shift = false;
+}
+
+// US ADB scan-code text conversion, independent of the PC Set-2 decoder.
+void asma2k_state::mac_adb_event(uint8_t event)
+{
+    bool const release = BIT(event, 7);
+    uint8_t const key = event & 0x7f;
+    if (key == 0x38 || key == 0x3c)
+    {
+        m_mac_shift = !release;
+        return;
+    }
+    if (release || key == 0x7f || event == 0xff)
+        return;
+    static constexpr struct { uint8_t key; char plain; char shift; } us[] = {
+        {0x00,'a','A'}, {0x0b,'b','B'}, {0x08,'c','C'}, {0x02,'d','D'},
+        {0x0e,'e','E'}, {0x03,'f','F'}, {0x05,'g','G'}, {0x04,'h','H'},
+        {0x22,'i','I'}, {0x26,'j','J'}, {0x28,'k','K'}, {0x25,'l','L'},
+        {0x2e,'m','M'}, {0x2d,'n','N'}, {0x1f,'o','O'}, {0x23,'p','P'},
+        {0x0c,'q','Q'}, {0x0f,'r','R'}, {0x01,'s','S'}, {0x11,'t','T'},
+        {0x20,'u','U'}, {0x09,'v','V'}, {0x0d,'w','W'}, {0x07,'x','X'},
+        {0x10,'y','Y'}, {0x06,'z','Z'}, {0x1d,'0',')'}, {0x12,'1','!'},
+        {0x13,'2','@'}, {0x14,'3','#'}, {0x15,'4','$'}, {0x17,'5','%'},
+        {0x16,'6','^'}, {0x1a,'7','&'}, {0x1c,'8','*'}, {0x19,'9','('},
+        {0x31,' ',' '}, {0x24,'\n','\n'}, {0x30,'\t','\t'},
+        {0x32,'`','~'}, {0x1b,'-','_'}, {0x18,'=','+'},
+        {0x21,'[','{'}, {0x1e,']','}'}, {0x2a,'\\','|'},
+        {0x29,';',':'}, {0x27,'\'','"'}, {0x2b,',','<'},
+        {0x2f,'.','>'}, {0x2c,'/','?'}
+    };
+    for (auto const &entry : us)
+    {
+        if (entry.key != key)
+            continue;
+        mac_sink_open();
+        if (m_mac_sink)
+        {
+            char const c = m_mac_shift ? entry.shift : entry.plain;
+            m_mac_sink->write(&c, 1);
+            m_mac_sink->flush();
+            logerror("AS2K_ADB_TEXT CHAR event=%02X char=%02X\n", event, uint8_t(c));
+        }
+        return;
+    }
+    logerror("AS2K_ADB_TEXT NON_TEXT event=%02X\n", event);
+}
+
+void asma2k_state::mac_adb_packet(uint16_t packet)
+{
+    ++m_mac_packets;
+    uint8_t const key1 = packet >> 8;
+    uint8_t const key2 = packet;
+    logerror("AS2K_ADB_PHY TALK_PACKET n=%llu value=%04X\n",
+        static_cast<unsigned long long>(m_mac_packets), unsigned(packet));
+    // ADB Register3 keyboard identity is 0x62/0x01; it is not text.
+    if (key1 == 0x62 && key2 == 0x01)
+        return;
+    mac_adb_event(key1);
+    if (key2 != 0xff)
+        mac_adb_event(key2);
 }
 
