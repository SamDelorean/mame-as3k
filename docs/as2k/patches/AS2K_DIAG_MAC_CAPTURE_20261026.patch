+void asma2k_state::diag_mac_sync()
+{
+    bool const connected = BIT(m_diag_mac->read(), 0);
+    if (connected == m_diag_mac_last)
+        return;
+    m_diag_mac_last = connected;
+    if (!connected)
+    {
+        mac_sink_close();
+        m_mac_bits = 0;
+        m_mac_started = false;
+        m_mac_rise_valid = false;
+    }
+    // External bus connection only; never write firmware host mode RAM.
+    m_maincpu->set_input_line(MC68HC11_IRQ_LINE, ASSERT_LINE);
+    logerror("AS2K_DIAG_MAC_HOST_EDGE_WAKE_IRQ attached=%u\n", connected ? 1U : 0U);
+}
