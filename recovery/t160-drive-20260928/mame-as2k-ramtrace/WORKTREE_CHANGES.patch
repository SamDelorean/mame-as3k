+							logerror("AS2K_GATE1B PREVIOUS_PC[%u]=%04X\n", i, m_as2k_gate1b_pc_history[idx]);
+						}
+					}
+				}
+				m_as2k_gate1b_pc_history[m_as2k_gate1b_pc_history_pos] = pc;
+				m_as2k_gate1b_pc_history_pos = (m_as2k_gate1b_pc_history_pos + 1) % 32;
