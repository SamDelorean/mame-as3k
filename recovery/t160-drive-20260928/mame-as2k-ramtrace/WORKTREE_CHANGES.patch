+				else if (pc == 0xd220)
+					m_as2k_ir_event_cb(0x01); // transmitter drained / frame-level wait complete
+				else if (pc == 0xd0d7)
+					m_as2k_ir_event_cb(0x30); // IrDA init complete, just before D099 returns
+				else if (pc == 0xd2dc)
+					m_as2k_ir_event_cb(0x10); // Send IrDA session entry
+				else if (pc == 0x9719)
+					m_as2k_ir_event_cb(0x11); // Send IrDA session return
+				else if (pc == 0xd437)
+					m_as2k_ir_event_cb(0x20); // Print IrDA session entry
+				else if (pc == 0xd47d)
+					m_as2k_ir_event_cb(0x21); // Print IrDA session return
+				// DIAG-only bounded IrDA application-path markers.  These are read-only
