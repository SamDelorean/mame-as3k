+		if (m_ir_peer_bit >= 10)
+		{
+			m_ir_peer_bit = 0;
+			++m_ir_peer_byte;
+		}
+		m_ir_peer_timer->adjust(attotime::from_ticks(bit_ticks, 2'000'000));
