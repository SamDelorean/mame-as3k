+							pc, m_d.d8.a, m_d.d8.b, m_ix, m_iy, m_sp);
+						++rx_marker_events;
+					}
+				}
+				// DIAG-only IrDA observation at firmware-defined byte/session boundaries.
+				// D1EF is the actual STAB $05BA enqueue, not D1EA (which spins while busy).
+				// This is passive: it does not alter registers, RAM, IRQs or timer state.
+				if (pc == 0xd1ef)
