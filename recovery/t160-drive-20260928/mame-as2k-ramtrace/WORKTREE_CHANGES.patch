+void asma2k_state::machine_reset()
+{
+	m_gate1b_current_pc = 0;
+	m_gate1b_instructions = 0;
+	m_gate1b_w1_reads = m_gate1b_w2_reads = m_gate1b_w3_reads = 0;
+	m_gate1b_quarantine_reads = m_gate1b_w4_reads = 0;
+	m_gate1b_ctrl_d079_reads = m_gate1b_ctrl_e0_reads = m_gate1b_ctrl_d8_reads = 0;
+	m_gate1b_tracked_writes = 0;
+	m_postir_ram_reads.fill(0);
+	m_postir_ram_writes.fill(0);
+	m_postir_ram_seen.clear();
+	logerror("AS2K_GATE1B_MEM_RESET counters=0\n");
+	printer_capture_end();
+	m_connection_mode = 0;
+	m_mode_disconnect_next = false;
+	m_printer_capture_armed = false;
+	m_ir_peer_send_session = false;
+	m_ir_peer_print_session = false;
+	m_ir_peer_primary = true;
+	m_ir_peer_print_discovery_replied = false;
+	ir_peer_stop();
+	ir_capture_end("reset");
+	alphasmart_state::machine_reset();
+	// IrDA receiver is optically idle HIGH on PA7/PAI.  Test pulses are
+	// injected explicitly by the PHY test, never implicitly at reset.
+	m_maincpu->set_input_line(MC68HC11_PAI_LINE, BIT(m_ir_pai->read(), 0) ? ASSERT_LINE : CLEAR_LINE);
 }
 
