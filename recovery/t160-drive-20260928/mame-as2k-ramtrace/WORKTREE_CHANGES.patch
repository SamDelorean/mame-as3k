+TIMER_CALLBACK_MEMBER(asma2k_state::ir_peer_timer)
+{
+	static constexpr uint64_t bit_ticks = 210;
+	static constexpr uint64_t pulse_ticks = 36;
+	if (!m_ir_peer_send_session && !m_ir_peer_print_session)
+	{
+		ir_peer_stop();
+		return;
+	}
+	if (!m_ir_peer_active)
+	{
+		// PA6 gates the AS2000 external I/O window.  Never begin an optical
+		// reply while firmware has that window selected for its own TX cycle.
+		if (m_ir_peer_pending && !BIT(m_port_a, 6))
+		{
+			m_ir_peer_timer->adjust(attotime::from_ticks(210, 2'000'000));
+			return;
+		}
+		uint8_t const pending = m_ir_peer_pending;
+		m_ir_peer_pending = 0;
+		if (pending == 1)
+		{
+			ir_peer_send_xid();
+			return;
+		}
+		if (pending == 2)
+		{
+			ir_peer_send_snrm();
+			return;
+		}
+		if (pending == 3)
+		{
+			ir_peer_send_rr(m_ir_peer_nr, true);
+			return;
+		}
+		if (pending == 4)
+		{
+			// IrLMP LM_CONNECT.confirm for IAS (DLSAP 0x52, SLSAP 0).
+			// Final zero is the TinyTP initial-credit field mirrored from the request.
+			ir_peer_send_i({ 0xd2, 0x00, 0x81, 0x00 });
+			return;
+		}
+		if (pending == 5)
+		{
+			// IAS GetValueByClass success: one object, Integer LSAP selector 0x11.
+			// 84=response/last, 00=success, list count=1, object id=1, type=integer.
+			ir_peer_send_i({ 0x52, 0x00, 0x84, 0x00, 0x00, 0x01, 0x00, 0x01,
+				0x01, 0x00, 0x00, 0x00, 0x11 });
+			return;
+		}
+		if (pending == 6)
+		{
+			// TinyTP/IrCOMM LM_CONNECT.confirm: peer service LSAP 0x11,
+			// AS client LSAP 0x53, and five initial credits as requested.
+			ir_peer_send_i({ 0xd3, 0x11, 0x81, 0x00, 0x05 });
+			return;
+		}
+		if (pending == 7)
+		{
+			// AlphaSmart application command BC 84 selects "Sending File".
+			// 53/11 are IrLMP destination/source, 05 grants TinyTP credits,
+			// 00 is the empty IrCOMM control channel.
+			ir_peer_send_i({ 0x53, 0x11, 0x05, 0x00, 0xbc, 0x84 });
+			return;
+		}
+		if (pending == 8)
