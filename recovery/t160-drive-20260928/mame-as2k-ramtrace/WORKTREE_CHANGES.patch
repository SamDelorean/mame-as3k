+void asma2k_state::gate1b_memory_read(unsigned probe, offs_t address, uint8_t data)
+{
+	static constexpr char const *names[] = { "W1", "W2", "W3", "Q_EADC", "W4", "CTRL_D079", "CTRL_E0", "CTRL_D8" };
+	uint64_t *counter = nullptr;
+	switch (probe)
+	{
+	case 0: counter = &m_gate1b_w1_reads; break;
+	case 1: counter = &m_gate1b_w2_reads; break;
+	case 2: counter = &m_gate1b_w3_reads; break;
+	case 3: counter = &m_gate1b_quarantine_reads; break;
+	case 4: counter = &m_gate1b_w4_reads; break;
+	case 5: counter = &m_gate1b_ctrl_d079_reads; break;
+	case 6: counter = &m_gate1b_ctrl_e0_reads; break;
+	case 7: counter = &m_gate1b_ctrl_d8_reads; break;
+	default: return;
+	}
+
+	++*counter;
+	uint64_t const log_limit = (probe <= 4) ? 512 : 8;
+	if (*counter > log_limit && ((*counter & 0x0fff) != 0))
+		return;
+
+	// HC11 state indices are stable in this local MAME core: SP=2, A=4,
