+void asma2k_state::gate1b_install_memory_probes()
+{
+	auto &space = m_maincpu->space(AS_PROGRAM);
+	auto const install_read = [this, &space](
+			memory_passthrough_handler &handler, offs_t start, offs_t end,
+			char const *name, unsigned probe)
+	{
+		handler.remove();
+		handler = space.install_read_tap(
+			start, end, name,
+			[this, probe](offs_t address, uint8_t &data, uint8_t mem_mask)
+			{
+				if (!machine().side_effects_disabled())
+					gate1b_memory_read(probe, address, data);
+			},
+			&handler);
+	};
+
+	install_read(m_gate1b_w1_tap, 0xd099, 0xd487, "as2k_gate1b_w1", 0);
+	install_read(m_gate1b_w2_tap, 0xd499, 0xd517, "as2k_gate1b_w2", 1);
+	install_read(m_gate1b_w3_tap, 0xe104, 0xeadb, "as2k_gate1b_w3", 2);
+	install_read(m_gate1b_quarantine_tap, 0xeadc, 0xeae7, "as2k_gate1b_quarantine", 3);
+	install_read(m_gate1b_w4_tap, 0xeae8, 0xffbf, "as2k_gate1b_w4", 4);
+
+	// Positive controls prove the taps are active on known retained table/string
+	// traffic; a zero W1-W4 count is meaningful only when a control is exercised.
+	install_read(m_gate1b_ctrl_d079_tap, 0xd079, 0xd098, "as2k_gate1b_ctrl_d079", 5);
+	install_read(m_gate1b_ctrl_e0_tap, 0xe0e0, 0xe103, "as2k_gate1b_ctrl_e0", 6);
+	install_read(m_gate1b_ctrl_d8_tap, 0xd8aa, 0xd9a9, "as2k_gate1b_ctrl_d8", 7);
+
+	m_gate1b_ram_write_tap.remove();
+	m_gate1b_ram_write_tap = space.install_write_tap(
+		0x0040, 0x0294, "as2k_gate1b_ram_provenance",
+		[this](offs_t address, uint8_t &data, uint8_t mem_mask)
+		{
+			if (!machine().side_effects_disabled())
+				gate1b_pointer_write(address, data);
+		},
+		&m_gate1b_ram_write_tap);
+
+	if (m_postir_ram_trace_enabled)
+	{
+		m_postir_ram_read_tap.remove();
+		m_postir_ram_write_tap.remove();
+		m_postir_ram_read_tap = space.install_read_tap(
+			0x0040, 0x00ff, "as2k_postir_internal_ram_read",
+			[this](offs_t address, uint8_t &data, uint8_t mem_mask)
+			{
+				if (!machine().side_effects_disabled())
+					postir_ram_access(false, address, data);
+			},
+			&m_postir_ram_read_tap);
+		m_postir_ram_write_tap = space.install_write_tap(
+			0x0040, 0x00ff, "as2k_postir_internal_ram_write",
+			[this](offs_t address, uint8_t &data, uint8_t mem_mask)
+			{
+				if (!machine().side_effects_disabled())
+					postir_ram_access(true, address, data);
+			},
+			&m_postir_ram_write_tap);
+		logerror("AS2K_POSTIR_RAM_TRACE_ACTIVE scenario=%s range=0040-00FF mode=unique_pc_plus_counts\n",
+			m_postir_ram_scenario.c_str());
+	}
+
+	logerror("AS2K_GATE1B_MEM_PROBE_ACTIVE W1=D099-D487 W2=D499-D517 W3=E104-EADB Q=EADC-EAE7 W4=EAE8-FFBF controls=D079-D098,E0E0-E103,D8AA-D9A9\n");
+}
