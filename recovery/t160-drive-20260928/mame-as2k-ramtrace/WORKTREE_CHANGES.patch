+				}
+				// Gate 1A DIAG: reserve evidence for the exit; never flood on $85B4.
+				if (pc == 0x8067 || pc == 0x806b || pc == 0x85a1 || pc == 0x85b4 || pc == 0x85be || pc == 0x85c2 || pc == 0x85c3 || pc == 0x85c4 || pc == 0x85c5 || pc == 0x806e || pc == 0x8070 || pc == 0x8078 || pc == 0x80d4)
+				{
+					static unsigned host_probe_events = 0;
+					static unsigned host_probe_poll_count = 0;
+					static bool host_probe_poll_logged = false;
+					static bool host_probe_wait_logged = false;
+					if (pc == 0x85b4) ++host_probe_poll_count;
