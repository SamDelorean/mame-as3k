+bool asma2k_state::gate1b_tracked_ram_byte(offs_t address) const
+{
+	static constexpr uint16_t pointer_bases[] = {
+		0x0040, 0x0044, 0x0046, 0x004c, 0x004e, 0x0050, 0x0052, 0x0062,
+		0x0067, 0x0120, 0x0122, 0x0124, 0x0126, 0x0128, 0x0278, 0x027c
+	};
+	uint16_t const a = uint16_t(address);
+	for (uint16_t const base : pointer_bases)
+		if (a == base || a == uint16_t(base + 1))
+			return true;
+
+	// Gate 1B hardening audit: also observe the volatile F-slot snapshot/cache tables.
+	if ((a >= 0x012a && a <= 0x0159) || (a >= 0x0192 && a <= 0x01a1))
+		return true;
+
+	// State directly implicated by the remaining C008/alias proof obligations.
+	return a == 0x0061 || a == 0x01f8 || a == 0x0290 || a == 0x0291 || a == 0x0294;
+}
