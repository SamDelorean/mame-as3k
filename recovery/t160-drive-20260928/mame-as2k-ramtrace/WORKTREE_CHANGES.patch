+void asma2k_state::printer_submit_host(std::string const &trace_path)
+{
+#if defined(__linux__)
+	// Linux DIAG-only host adapter. The helper validates the captured PCL
+	// before delivering *text/plain* to the default CUPS destination.
+	// Resolve beside this same DIAG executable: no extra MAME builds.
+	char executable[4096];
+	ssize_t const count = ::readlink("/proc/self/exe", executable, sizeof(executable) - 1);
+	if (count <= 0)
+	{
+		logerror("AS2K_PRINT_HOST FAILED reason=cannot_locate_diag_executable\n");
+		return;
+	}
+	executable[count] = 0;
+	std::string const binary_path(executable);
+	auto const slash = binary_path.find_last_of('/');
+	std::string const helper = binary_path.substr(0, slash) + "/scripts/as2k_print_to_host.py";
+	if (::access(helper.c_str(), R_OK) != 0)
+	{
+		logerror("AS2K_PRINT_HOST FAILED reason=missing_helper path=%s\n", helper);
+		return;
+	}
+	char *const args[] = { const_cast<char *>("/usr/bin/python3"),
+		const_cast<char *>(helper.c_str()), const_cast<char *>(trace_path.c_str()), nullptr };
+	pid_t pid;
+	int const error = ::posix_spawn(&pid, "/usr/bin/python3", nullptr, nullptr, args, environ);
+	if (error)
+	{
+		logerror("AS2K_PRINT_HOST FAILED reason=spawn_error code=%d\n", error);
+		return;
+	}
+	int status = 0;
+	if (::waitpid(pid, &status, 0) != pid || !WIFEXITED(status) || WEXITSTATUS(status))
+	{
+		logerror("AS2K_PRINT_HOST FAILED reason=helper_exit status=%d raw_preserved=%s\n",
+			status, trace_path);
+		popmessage("AlphaSmart: host printing failed; RAW trace preserved");
+	}
+	else
+	{
+		logerror("AS2K_PRINT_HOST SUBMITTED trace=%s\n", trace_path);
+		popmessage("AlphaSmart: print job submitted to host");
+	}
+#else
+	logerror("AS2K_PRINT_HOST unavailable_on_this_platform trace=%s\n", trace_path);
+#endif
+}
