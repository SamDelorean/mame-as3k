+					for (unsigned covered = 0; covered < 0x10000; ++covered)
+						if (m_as2k_ir_pc_coverage.test(covered))
+							logerror("AS2K_IR_COVERAGE PC=%04X\n", covered);
+					m_as2k_ir_coverage_active = false;
+				}
+				// Receive-path milestones selected from the stock firmware/Ghidra
+				// call graph.  They are bounded semantic observations, not hooks.
+				if (pc == 0xd0e0 || pc == 0xd107 || pc == 0xd166 || pc == 0xe58c ||
